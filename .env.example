# Optional host ports for Docker Compose. Container ports stay unchanged.
FRONTEND_PORT=5173
FRONTEND_PREVIEW_PORT=4173
BACKEND_PORT=8080

# Backend configuration, explicitly passed by Compose.
OWNER_NAME=Дмитрий Степанов
DATABASE_URL=postgres://booking:booking@postgres:5432/booking?sslmode=disable
# Optional JSON weekdays/intervals in Europe/Moscow; empty = Mon-Fri 09:00-18:00.
# WORK_SCHEDULE='{"mon":[{"start":"09:00","end":"12:00"},{"start":"13:00","end":"18:00"}]}'
WORK_SCHEDULE=
